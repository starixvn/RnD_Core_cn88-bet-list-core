@{
    Layout = "~/Views/Shared/_LayoutCN88.cshtml";
}
@using Fanex.BetList.Core.Entities
@using CN88.BetList.Core.Builders;
@using Fanex.BetList.Example.MVC.ViewModel
@using Fanex.BetList.Core.TicketHelper
@using Fanex.BetList.Core.Entities
@using Fanex.BetList.Core.Factories
@using Fanex.BetList.Core.Builder
@using Fanex.BetList.Core.TicketHelper
@model BetListData
@{
    ViewBag.Title = "Bet List CN88 Demo";

    IList<ITicket> tickets = (Model != null) ? Model.Tickets : (IList<ITicket>)new List<Ticket>();
    List<ITicketData> ticketData = Model.TicketData;


    var cn88Builder = new BetListCN88HtmlBuilder();
    var factory = new BetListHTMLFactory();
    BetListHTMLBuilder builder = factory.CreateBuilder();


    ITicketHelper ticketHelper = new TicketHelper();

    Func<object, string> funcGetOddsTypeName = ticketHelper.GetOddsTypeNameById;
    var isShowScoreMap = Model.BetTypeId == 145 || Model.BetTypeId == 146 || Model.BetTypeId == 151;
    var rowIndex = 0;
}
@using (Html.BeginForm())
{
    <div class="panel panel-default">
        <div class="panel-body">
            <div class="row">
                <div class="col-lg-3">
                    @Html.DropDownListFor(m => m.BetTypeId, (IEnumerable<SelectListItem>)ViewBag.BetTypes, "All", new { @class = "form-control" })
                </div>
                <div class="col-lg-3">
                    <input type="submit" value="Submit" class="btn btn-primary" />
                    <span class="alert alert-succes">@Html.ActionLink("Export list to excel", "ExportExcel", new { Language = Model.Language, BetTypeId = Model.BetTypeId })</span>
                </div>
                <div class="col-lg-2">
                    <select class="form-control" data-val="true" id="Language" name="Language" onchange="this.form.submit()">
                        <option value="en-US">en-US</option>
                        <option value="ja-JP">ja-JP</option>
                        <option value="ko-KR">ko-KR</option>
                        <option value="th-TH">th-TH</option>
                        <option value="vi-VN">vi-VN</option>
                        <option value="zh-CN">zh-CN</option>
                        <option value="zh-TW">zh-TW</option>
                        <option value="zh-Hans">zh-Hans</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

}
<table class="table table-striped table-bordered">
    <thead>
        <tr class="success">
            <th>
                #
            </th>
            <th>
                Bet Type ID
            </th>
            <th>
                Bet ID / Bet Type (CN88)
            </th>
            <th>
                Details (CN88)
            </th>
            <th>
                Choice (MBC)
            </th>
            <th>
                Odds (MBC)
            </th>
            <th>
                Status
            </th>
            @*<th>
                    ITicket
                </th>*@
        </tr>
    </thead>
    <tbody>
        @foreach (var ticket in tickets)
        {
            rowIndex++;

            <tr>
                <td class="text-center">
                    @rowIndex
                </td>
                <td class="text-center">
                    @ticket.UserName
                </td>
                <td class="text-left">
                    @Html.Raw(cn88Builder.BuildBetInfo(ticket, ticketHelper, funcGetOddsTypeName))
                </td>
                <td class="text-left">
                    @Html.Raw(cn88Builder.BuildChoice(ticket, ticketHelper, ticketData))
                </td>
                <td class="text-right" style="width: 45%; text-align: justify; font-size:10px;">
                    @Html.Raw(builder.BuildChoice(ticket, ticketHelper, ticketData, isShowScoreMap))
                </td>
                <td class="text-left">
                    @Html.Raw(builder.BuildOdds(ticket, ticketData, ticketHelper.GetOddsTypeNameById))
                </td>
                <td class="text-center">
                    @Html.Raw(builder.BuildStatus(ticket, ticketHelper, ticketData, false))
                </td>
                @*<td class="text-right" style="width: 45%; text-align: justify; font-size:10px;">
                        @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ticket, Newtonsoft.Json.Formatting.Indented))
                    </td>*@
            </tr>
        }
    </tbody>
</table>
<script src="~/Scripts/chosen_v1.8.7/chosen.jquery.min.js"></script>
<script>


    $(function () {
        $("#BetTypeId").chosen();
        $("#Language").val(@Html.Raw("'" + Model.Language +"'"));
    });

    function showDetail(id) {
        var e = document.getElementById(id);
        if (e.style.display == 'block')
            e.style.display = 'none';
        else
            e.style.display = 'block';
    }

    function showParlaySubBetsCN88(transId, index, refNo, handicap1, handicap2, betCheck, betTeam, custId, sourceElement) {
        var $parent = $(sourceElement).parent();
        if ($parent.hasClass("cn88-mix-parlay-collapse")) {
            $parent.removeClass("cn88-mix-parlay-collapse");
        }
        else {
            $parent.addClass("cn88-mix-parlay-collapse");
        }

        // Place Your Code Here.
        alert("Alert from showParlaySubBetsCN88");
    }

    function showCombMPDetail(winlostDate, transId, betId, custId, betTeam, sourceElement) {
        // Place Your Code Here.
        alert("Alert from showCombMPDetail");
    }
</script>
